# Local backend configuration template.
# Copy this file to .env and replace the placeholder values.
# Never commit backend/.env.

SERVER_PORT=8082

# Local PostgreSQL
DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/tripmate_auth
DATABASE_USERNAME=tripmate
DATABASE_PASSWORD=CHANGE_ME

# JWT signing key: use a random value of at least 32 characters locally.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

# Gmail SMTP
EMAIL_MODE=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=PASTE_GMAIL_APP_PASSWORD_HERE
MAIL_FROM=your-gmail-address@gmail.com

# OTP and rate-limit settings
EMAIL_VERIFICATION_TTL=3m
EMAIL_RESEND_COOLDOWN=60s
AUTH_RATE_LIMIT_PER_WINDOW=10
OTP_RATE_LIMIT_PER_WINDOW=5

# Leave empty until Google OAuth is configured.
GOOGLE_WEB_CLIENT_ID=
