{
  "expo": {
    "name": "TripMate",
    "slug": "tripmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.tripmate.app",
      "adaptiveIcon": {
        "backgroundColor": "#2F80ED"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "Cho phép TripMate chọn ảnh đại diện từ thư viện.", "cameraPermission": false, "microphonePermission": false }],
      ["expo-location", { "locationWhenInUsePermission": "Cho phép TripMate dùng vị trí để hiển thị địa điểm gần bạn." }]
    ]
  }
}
