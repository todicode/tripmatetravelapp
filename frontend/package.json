{
  "name": "tripmate-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "node scripts/run-android.cjs",
    "android:all": "node scripts/run-android.cjs --all-emulators",
    "test:android": "node --test scripts/check-all-emulators.cjs",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --test scripts/check-auth.cjs",
    "test:profile": "node --test scripts/check-profile.cjs",
    "test:friends": "node --test scripts/check-friends.cjs",
    "test:messages": "node --test scripts/check-direct-messages.cjs scripts/check-direct-realtime.cjs",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@stomp/stompjs": "7.3.0",
    "expo": "^57.0.23",
    "expo-asset": "^57.0.17",
    "expo-camera": "~57.0.6",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
